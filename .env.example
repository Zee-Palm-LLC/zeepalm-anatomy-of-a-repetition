# The public origin of the deployed site. Canonical URLs, the sitemap and the
# Open Graph card are absolute, so set this before the first deploy.
#
# A bare host is fine ("zeepalm.com" becomes "https://zeepalm.com"), and an
# empty or malformed value falls back to a placeholder rather than failing the
# build. Paths and trailing slashes are stripped.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
